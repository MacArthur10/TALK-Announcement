# API Configuration
# Use your computer's Wi-Fi IP address for testing on physical devices
EXPO_PUBLIC_API_URL=http://192.168.1.52:4000/api

# Alternative configurations (uncomment as needed):
# For Android Emulator (points to host machine's localhost)
# EXPO_PUBLIC_API_URL=http://10.0.2.2:4000/api

# For iOS Simulator (localhost works)
# EXPO_PUBLIC_API_URL=http://localhost:4000/api

# For VirtualBox/VMware (if using VM)
# EXPO_PUBLIC_API_URL=http://192.168.56.1:4000/api

# Other environment variables
EXPO_PUBLIC_APP_NAME=CAD3 Intranet
EXPO_PUBLIC_APP_VERSION=1.0.0